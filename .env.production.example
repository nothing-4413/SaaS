APP_ENV=production
HTTP_ADDR=:8080
DATABASE_URL=postgres://app:replace-me@db.example.com:5432/stockpilot?sslmode=require
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_PREVIOUS_SECRETS=
APP_PUBLIC_URL=https://inventory.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
STOCK_ALERT_INTERVAL_SECONDS=60
WORKER_HEALTH_ADDR=:9090
